     "expect": {
      "status": 200,
      "schema": "LoginPoll",
      "body": {
       "/state": "pending"
      }
     }
    }
   ]
  },
  {
   "id": "session-08",
   "title": "Logout ends the session; later calls answer session_ended and a repeat logout is 204",
   "world": "two-fleets",
   "steps": [
    {
     "action": "issue-session",
     "args": {
      "user": "alice"
     },
     "capture": "a_ref"
    },
    {
     "action": "user-id",
     "args": {
      "user": "alice"
     },
     "capture": "a_uid"
    },
    {
     "request": {
      "operation": "logout",
      "body": {
       "caller": {
        "user_id": "${a_uid}",
        "session_ref": "${a_ref}"
       }
      }
     },
     "expect": {
      "status": 204,
      "schema": null
     }
    },
    {
     "request": {
      "operation": "listDevices",
      "body": {
       "caller": {
        "user_id": "${a_uid}",
        "session_ref": "${a_ref}"
       }
      }
     },
     "expect": {
      "status": 403,
      "schema": "Refusal",
      "body": {
       "/code": "session_ended",
       "/retryable": false
      }
     }
    },
    {
     "request": {
      "operation": "logout",
      "body": {
       "caller": {
        "user_id": "${a_uid}",
        "session_ref": "${a_ref}"
       }
      }
     },
     "expect": {
      "status": 204,
      "schema": null
     }
    }
   ]
  },
  {
   "id": "session-09",
