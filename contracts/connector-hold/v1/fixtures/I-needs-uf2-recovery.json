      "frame": {
        "type": "iface_relay",
        "serial_dfu": true
      }
    },
    {
      "step": "device_link",
      "port": "application",
      "event": "absent"
    },
    {
      "step": "device_link",
      "port": "bootloader",
      "event": "present"
    },
    {
      "step": "send",
      "frame": {
        "type": "connector_device",
        "device": "bootloader",
        "dfu_state": "needs-uf2-recovery",
        "job": "fw-7",
        "sent": 689,
        "total": 1358
      }
    },
    {
      "step": "send",
      "frame": {
        "type": "dfu_state",
        "job": "fw-7",
        "state": "needs-uf2-recovery",
        "sent": 689,
        "total": 1358
      }
    },
    {
