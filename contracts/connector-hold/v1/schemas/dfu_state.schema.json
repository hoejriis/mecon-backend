{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mecon:connector-hold:v1:dfu_state",
  "title": "dfu_state (agent to Backend)",
  "description": "Where the agent is with the armed job. The Backend records each state on the job and relays the bootloader-dfu offer only after ready for that job on that socket. failed carries the stage and a short error code; no other state carries them. Not acknowledged; the current state is sent again once on a new socket while a job is under way or failed.",
  "type": "object",
  "required": [
    "type",
    "job",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "dfu_state"
    },
    "job": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._:-]{0,63}$"
    },
    "state": {
      "enum": [
        "fetching",
        "ready",
        "waiting-bootloader",
        "transferring",
        "rebooting",
        "installed-pending-hello",
        "failed"
      ]
    },
    "stage": {
      "enum": [
        "fetch",
        "verify",
        "bootloader",
        "transfer",
        "app-return"
      ]
    },
    "error": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    }
  },
  "if": {
    "properties": {
      "state": {
        "const": "failed"
      }
    }
  },
  "then": {
    "required": [
      "stage",
      "error"
    ]
  },
  "else": {
    "not": {
      "anyOf": [
        {
          "required": [
            "stage"
          ]
        },
        {
          "required": [
            "error"
          ]
        }
      ]
    }
  }
}
