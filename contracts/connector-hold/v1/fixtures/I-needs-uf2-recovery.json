{
  "contract": "mecon-connector-hold/1.0.0-draft.5",
  "synthetic": true,
  "id": "I",
  "title": "A board that needs a UF2 copy, reported on a new socket and ended by the hello",
  "description": "A serial DFU was interrupted after data writing began (689 of 1358 data packets acknowledged), and the agent recorded it locally. The process has since restarted: the application port is absent and the bootloader's port is listed. On the new socket the agent declares, reports the device as being in its bootloader and the needs-uf2-recovery state, and sends the dfu_state. A dfu_job for another job is answered with the same state for that job id: nothing is fetched and no serial transfer starts. The operator copies the release's recovery UF2 to the board; the application port returns, the agent declares and says hello again, and the record ends with that hello. The Backend confirms the version from the hello.",
  "link": "companion",
  "steps": [
    {
      "step": "handshake",
      "presentation": "header",
      "offered": [
        "Authorization: Bearer <token>"
      ],
      "selected": null
    },
