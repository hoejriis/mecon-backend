{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation-processing/v1/packet",
  "title": "One deduplicated packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "packet_type", "first_seen_at", "last_seen_at"],
  "properties": {
    "packet_id": { "type": "string", "pattern": "^[0-9A-F]{16}$", "description": "The packet identity (README section 3)." },
    "packet_type": { "type": "string", "pattern": "^([A-Z_]+|UNKNOWN_0x[0-9a-f]{2})$" },
    "first_seen_at": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$" },
    "last_seen_at": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$" }
  }
}
