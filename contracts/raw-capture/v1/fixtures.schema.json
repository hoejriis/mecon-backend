{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raw-capture/v1/fixtures",
  "title": "Raw capture fixtures",
  "type": "object",
  "required": ["fixture", "title", "kind"],
  "properties": {
    "fixture": { "type": "string", "pattern": "^[A-Z]$" },
    "title": { "type": "string" },
    "kind": { "enum": ["append", "counters", "invalid"] },
    "limits": { "type": "object", "required": ["max_payload_bytes"], "properties": { "max_payload_bytes": { "type": "integer", "minimum": 1 } } },
    "request": { "type": "object" },
    "result": { "type": "object" },
    "after": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "counters": { "type": "object" },
    "cases": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["schema", "note", "value"],
               "properties": { "schema": { "enum": ["capture", "append-request", "append-result", "counters"] }, "note": { "type": "string" }, "value": {} } } }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "append" } } }, "then": { "required": ["limits", "request", "result"] } },
    { "if": { "properties": { "kind": { "const": "counters" } } }, "then": { "required": ["after", "counters"] } },
    { "if": { "properties": { "kind": { "const": "invalid" } } }, "then": { "required": ["cases"] } }
  ]
}
