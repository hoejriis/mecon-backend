        "user_id": "${a_uid}",
        "session_ref": "${a_ref}"
       }
      }
     },
     "expect": {
      "status": 200,
      "schema": "ConversationList"
     },
     "capture": {
      "a_bob": {
       "at": "/items",
       "where": {
        "/title": "Bob (synthetic)"
       },
       "field": "/id"
      }
     }
    },
    {
     "action": "end-session",
     "args": {
      "session_ref": "${a_ref}"
     }
    },
    {
     "request": {
      "operation": "listChannels",
