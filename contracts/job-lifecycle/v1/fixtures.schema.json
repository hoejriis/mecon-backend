{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/mecon/job-lifecycle/v1/fixtures",
  "title": "Job lifecycle fixtures",
  "type": "object",
  "required": ["fixture", "title", "kind", "contract_version"],
  "properties": {
    "fixture": { "type": "string", "pattern": "^[A-Z]$" },
    "title": { "type": "string" },
    "contract_version": { "const": "1.0.0-draft.1" },
    "kind": { "enum": ["lifecycle", "invalid"] },
    "setup": { "type": "object", "additionalProperties": false, "required": ["start", "devices", "rights"],
      "properties": { "start": { "type": "string" },
        "devices": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["role", "member", "blocked"], "properties": { "role": { "enum": ["companion", "repeater"] }, "member": { "type": "boolean" }, "blocked": { "type": "boolean" } } } },
        "rights": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } } } },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["step", "expect"],
      "properties": {
        "step": { "enum": ["create", "read", "list", "claim", "sign", "deliver", "transport_ack", "device_answer", "device_event", "advance", "restart", "cancel", "authority"] },
        "expect": { "type": "object", "additionalProperties": false, "required": ["response", "out", "ignored_results", "jobs"],
          "properties": { "response": { "type": "object" }, "out": { "type": "array" }, "ignored_results": { "type": "integer", "minimum": 0 }, "jobs": { "type": "array" } } } } } },
    "cases": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["schema", "note", "value"],
      "properties": { "schema": { "enum": ["job", "attempt", "control", "outcome", "error", "response", "delivery", "create-request"] }, "note": { "type": "string" }, "value": {} } } }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "lifecycle" } } }, "then": { "required": ["setup", "steps"] } },
    { "if": { "properties": { "kind": { "const": "invalid" } } }, "then": { "required": ["cases"] } }
  ]
}
