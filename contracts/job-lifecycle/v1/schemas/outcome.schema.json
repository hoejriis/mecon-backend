{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/mecon/job-lifecycle/v1/outcome",
  "title": "The outcome of a job that reached a terminal state",
  "description": "Which reason fits which terminal state is in README section 3; the validator checks it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reason", "device_status", "at"],
  "properties": {
    "reason": { "enum": ["device_final", "authority", "nothing_ran", "caller_before_dispatch", "device_confirmed", "expiry", "abandon_deadline"] },
    "device_status": { "oneOf": [{ "type": "null" }, { "$ref": "https://example.test/mecon/device-dispatch/v1/result#/properties/status" }] },
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}
