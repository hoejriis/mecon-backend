{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/mecon/device-dispatch/v1/fixtures",
  "title": "Device dispatch fixtures",
  "type": "object",
  "required": [
    "fixture",
    "title",
    "kind",
    "contract_version"
  ],
  "properties": {
    "fixture": {
      "type": "string",
      "pattern": "^[A-Z]$"
    },
    "title": {
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0-draft.1"
    },
    "kind": {
      "enum": [
        "dispatch",
        "commands",
        "origin",
        "invalid"
      ]
    },
    "setup": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step",
          "t",
          "expect"
        ],
        "properties": {
          "step": {
            "enum": [
              "sign",
              "transport_accept",
              "result"
            ]
          },
          "t": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "note",
          "setup",
          "steps"
        ],
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "step",
                "t",
                "expect"
              ],
              "properties": {
                "step": {
                  "enum": [
                    "start",
                    "result",
                    "heard",
                    "authority",
                    "native_ack",
                    "tick"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "dispatch"
          }
        }
      },
      "then": {
        "required": [
          "setup",
          "steps"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "commands"
          }
        }
      },
      "then": {
        "required": [
          "cases"
        ],
        "properties": {
          "cases": {
            "items": {
              "required": [
                "note",
                "by",
                "role",
                "command",
                "expect"
              ],
              "properties": {
                "by": {
                  "enum": [
                    "caller",
                    "backend"
                  ]
                },
                "role": {
                  "enum": [
                    "companion",
                    "repeater"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "origin"
          }
        }
      },
      "then": {
        "required": [
          "runs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "invalid"
          }
        }
      },
      "then": {
        "required": [
          "cases"
        ],
        "properties": {
          "cases": {
            "items": {
              "required": [
                "schema",
                "note",
                "value"
              ],
              "properties": {
                "schema": {
                  "enum": [
                    "command",
                    "result",
                    "dispositions",
                    "origin-state"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
