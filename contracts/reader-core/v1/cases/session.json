     },
     "expect": {
      "status": 202,
      "schema": "LoginStarted"
     },
     "capture": {
      "rid": "/request_id"
     }
    },
    {
     "action": "exhaust-login-limit",
     "args": {
      "client_address": "192.0.2.30"
     }
    },
    {
     "request": {
      "operation": "pollLogin",
      "body": {
       "request_id": "${rid}",
       "client_address": "192.0.2.30"
      }
     },
     "expect": {
      "status": 429,
      "schema": "RateLimited",
      "body": {
       "/code": "rate_limited",
