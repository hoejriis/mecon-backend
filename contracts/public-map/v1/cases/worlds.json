{
 "contract": "mecon-public-map/1.0.0-draft.1",
 "synthetic": true,
 "actions": {
  "sign-in": {
   "args": [
    "client",
    "user"
   ],
   "description": "Give `client` a live session of `user` by the implementation's own means, as the Reader API cases do. Every later request of that client carries the session cookie."
  },
  "present-bearer": {
   "args": [
    "client",
    "issued"
   ],
   "description": "Every later request of `client` carries an `Authorization: Bearer` header. `issued` true: a valid agent token of the instance; false: a string the Backend never issued. Made up either way."
  },
  "use-address": {
   "args": [
    "client",
    "address"
   ],
   "description": "Requests of `client` come from this client address (as the Backend sees it, whatever proxy header it trusts). Clients without this action share one default address, and a fresh anonymous step uses it too."
  },
  "transmit": {
   "args": [
    "node",
    "heard_by",
    "ago_s"
   ],
   "description": "Record one advertisement packet sent by `node`, received `ago_s` seconds before now by each observer of `heard_by`, and let the Backend publish what is due (by whatever means its own tests use to run its refresh; the packet is at least 3 seconds old so it has settled). Every reception carries the world's signal values, topic, source and packet hash."
  },
  "transmit-via-path": {
   "args": [
    "node",
    "heard_by",
    "ago_s",
    "path",
    "hash_size"
   ],
   "description": "As `transmit`, for a flooded packet whose recorded path lists the nodes of `path` in order, each hop as the first `hash_size` bytes of that node's key."
  },
  "advance-clock": {
   "args": [
    "seconds"
   ],
   "description": "Move the Backend's clock forward by `seconds` and run its periodic work."
  },
  "withdraw-position": {
   "args": [
    "node"
   ],
   "description": "The node advertises again, without a position, and the Backend re-reads who is eligible within the time the contract allows (the case advances the clock)."
  },
  "set-feed": {
   "args": [
    "enabled"
   ],
   "description": "Set the instance setting that switches the public feed on or off."
  },
  "lower-rate-limit": {
   "args": [
    "requests"
   ],
   "description": "Make the Backend count only this many requests per client address, both operations together, before it answers 429. A test hook for the limit the Backend has anyway; the window is its own."
  },
  "lower-response-cap": {
   "args": [
    "events"
   ],
   "description": "Make the Backend carry at most this many events per response. A test hook for the cap the Backend has anyway."
  },
  "forge-cursor": {
   "args": [
    "cursor",
    "mode"
   ],
   "description": "Capture a cursor built from `cursor`: `fresh-issue-time-unsigned` (issue time set to now, the Backend's signature replaced by zeros) or `fresh-issue-time-old-signature` (issue time set to now, the old signature kept)."
  }
 },
 "worlds": {
  "public-map": {
   "description": "One Backend with the feed on. Every key, name, position and marker is made up. A node is `listed` in the description of each entry only if the contract says it should be. Sources: `owned` (the instance owner operates it), `approved_feed` (a third party feed approved for publication) and `other_feed` (neither). Receivers: observers; `public_obs` and `public_obs2` are themselves listed public nodes; `private_obs` has an operator-set position; `inferred_obs` a position the Backend inferred; `ineligible_obs` hears only on `other_feed`; `other_party_obs` is a device of a fleet the instance's owner does not own, reporting through `owned`. All of them report signal strength `-113.5` and `7.25`, topic `private-topic-synthetic`, source name `source-name-synthetic`, gateway label `gateway-label-synthetic`, fleet name `Fleet North (synthetic)`, and the packet hash below.",
