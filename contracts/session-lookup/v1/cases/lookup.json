{
 "contract": "mecon-session-lookup/1.0.0-draft.3",
 "synthetic": true,
 "group": "lookup",
 "cases": [
  {
   "id": "lookup-01",
   "title": "A live session gives a Caller with exactly the documented fields and no scope",
   "world": "basic",
   "steps": [
    {
     "action": "issue-session",
     "args": {
      "user": "alice"
     },
     "capture": "cookie"
    },
    {
     "request": {
      "operation": "lookupCaller",
      "body": {
       "credential": "${cookie}",
       "purpose": "read",
       "origin": null,
       "sec_fetch_site": "same-origin"
      }
     },
     "expect": {
      "status": 200,
      "schema": "Caller",
      "body": {
       "/role": "user",
       "/break_glass": false,
       "/display_name": "Alice (synthetic)"
      }
     }
    }
   ]
  },
