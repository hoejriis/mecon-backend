{
 "contract": "mecon-reader-core/1.0.0-draft.3",
 "synthetic": true,
 "group": "send",
 "cases": [
  {
   "id": "send-01",
   "title": "A new attempt answers 201 and reads back by id",
   "world": "two-fleets",
   "steps": [
    {
     "action": "issue-session",
     "args": {
      "user": "alice"
     },
     "capture": "a_ref"
    },
    {
     "action": "user-id",
     "args": {
      "user": "alice"
     },
     "capture": "a_uid"
    },
    {
     "request": {
      "operation": "listIdentities",
      "body": {
       "caller": {
        "user_id": "${a_uid}",
        "session_ref": "${a_ref}"
       }
      }
     },
     "expect": {
      "status": 200,
      "schema": "IdentityList"
     },
     "capture": {
      "a_idn": "/items/0/id"
     }
    },
    {
     "request": {
      "operation": "listContacts",
      "body": {
       "caller": {
        "user_id": "${a_uid}",
        "session_ref": "${a_ref}"
       }
      }
     },
     "expect": {
      "status": 200,
      "schema": "ContactList"
     },
     "capture": {
      "a_peer": {
       "at": "/items",
       "where": {
        "/display_name": "Bob (synthetic)"
       },
       "field": "/id"
      }
     }
    },
    {
     "request": {
      "operation": "listChannels",
      "body": {
       "caller": {
        "user_id": "${a_uid}",
        "session_ref": "${a_ref}"
       }
      }
     },
     "expect": {
      "status": 200,
      "schema": "ChannelList"
     },
     "capture": {
      "a_public": {
       "at": "/items",
       "where": {
        "/name": "Public (synthetic)"
       },
       "field": "/id"
      }
     }
    },
    {
     "request": {
      "operation": "createSendAttempt",
      "body": {
       "caller": {
        "user_id": "${a_uid}",
        "session_ref": "${a_ref}"
       },
       "request": {
        "client_draft_id": "drf_synthetic_s01",
        "client_attempt_id": "cat_synthetic_s01",
        "identity_id": "${a_idn}",
        "target": {
         "kind": "contact",
         "id": "${a_peer}"
        },
        "content": {
         "kind": "text",
         "text": "hello (synthetic)"
        }
       }
      }
     },
     "expect": {
      "status": 201,
      "schema": "SendAttempt",
      "body": {
       "/client_attempt_id": "cat_synthetic_s01",
       "/identity_id": "${a_idn}",
       "/path": "backend"
      }
     },
     "capture": {
      "att": "/id"
     }
    },
    {
     "request": {
      "operation": "getSendAttempt",
      "body": {
       "caller": {
        "user_id": "${a_uid}",
        "session_ref": "${a_ref}"
       },
       "attempt_id": "${att}"
      }
     },
     "expect": {
      "status": 200,
      "schema": "SendAttempt",
      "body": {
       "/id": "${att}"
      }
     }
    }
   ]
  },
