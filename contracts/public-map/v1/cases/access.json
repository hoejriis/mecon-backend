{
 "contract": "mecon-public-map/1.0.0-draft.1",
 "synthetic": true,
 "group": "access",
 "cases": [
  {
   "id": "access-01",
   "title": "With the feed switched off both operations answer 404, whatever the cursor, and publish nothing",
   "world": "public-map",
   "steps": [
    {
     "action": "transmit",
     "args": {
      "node": "tx_one",
      "heard_by": [
       "public_obs"
      ],
      "ago_s": 3
     }
    },
    {
     "action": "set-feed",
     "args": {
      "enabled": false
     }
    },
    {
     "request": {
      "operation": "getPublicNodes"
     },
     "expect": {
      "status": 404,
      "schema": "Error",
      "body": {
       "/code": "not_found",
       "/retryable": false
      },
      "absent": {
       "keys": [
        "nodes",
        "as_of"
       ]
      }
     }
    },
    {
     "request": {
      "operation": "getPublicEvents"
     },
     "expect": {
      "status": 404,
      "schema": "Error",
      "body": {
       "/code": "not_found"
      },
      "absent": {
       "keys": [
        "events",
        "cursor"
       ]
      }
     }
    },
    {
     "request": {
      "operation": "getPublicEvents",
      "query": {
       "since": "nonsense"
      }
     },
     "expect": {
      "status": 404,
      "schema": "Error",
      "body": {
       "/code": "not_found"
      },
      "absent": {
       "keys": [
        "events",
        "cursor"
       ]
      }
     }
    },
    {
     "action": "set-feed",
     "args": {
      "enabled": true
     }
    },
    {
     "request": {
      "operation": "getPublicNodes"
     },
     "expect": {
      "status": 200,
      "schema": "PublicNodeList",
      "match": [
       {
        "at": "/nodes",
        "where": {
         "/public_node_id": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        },
        "count": 1
       }
      ]
     }
    }
   ]
  },
  {
   "id": "access-02",
   "title": "The rate limit is per client address, both operations together, with Retry-After",
   "world": "public-map",
   "steps": [
    {
     "action": "use-address",
     "args": {
      "client": "busy",
      "address": "203.0.113.7"
     }
    },
    {
     "action": "use-address",
     "args": {
      "client": "other",
      "address": "203.0.113.9"
     }
    },
    {
     "action": "lower-rate-limit",
     "args": {
      "requests": 3
     }
    },
    {
     "as": "busy",
     "request": {
      "operation": "getPublicEvents"
     },
     "expect": {
      "status": 200,
      "schema": "PublicEventList"
     }
    },
    {
     "as": "busy",
     "request": {
      "operation": "getPublicEvents"
     },
     "expect": {
      "status": 200,
      "schema": "PublicEventList"
     }
    },
    {
     "as": "busy",
     "request": {
      "operation": "getPublicNodes"
     },
     "expect": {
      "status": 200,
      "schema": "PublicNodeList",
      "match": [
       {
        "at": "/nodes",
        "where": {
         "/public_node_id": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        },
        "count": 1
       }
      ]
     }
    },
    {
     "as": "busy",
     "request": {
      "operation": "getPublicEvents"
     },
     "expect": {
      "status": 429,
      "schema": "Error",
      "headers": {
       "Retry-After": "present"
      },
      "body": {
       "/code": "throttled",
       "/retryable": true
      },
      "absent": {
       "keys": [
        "events",
        "cursor",
        "nodes"
       ]
      }
     }
    },
    {
     "as": "busy",
     "request": {
      "operation": "getPublicNodes"
     },
     "expect": {
      "status": 429,
      "schema": "Error",
      "headers": {
       "Retry-After": "present"
      },
      "body": {
       "/code": "throttled"
      },
      "absent": {
       "keys": [
        "events",
        "nodes"
       ]
      }
     }
    },
    {
     "as": "other",
     "request": {
      "operation": "getPublicNodes"
     },
     "expect": {
      "status": 200,
      "schema": "PublicNodeList",
      "match": [
       {
        "at": "/nodes",
        "where": {
         "/public_node_id": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
        },
        "count": 1
       }
      ]
     }
    }
   ]
  },
