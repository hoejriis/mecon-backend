{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation-processing/v1/fixtures",
  "title": "Observation processing fixtures",
  "type": "object",
  "required": ["fixture", "title", "kind"],
  "properties": {
    "fixture": { "type": "string", "pattern": "^[A-Z]$" },
    "title": { "type": "string" },
    "kind": { "enum": ["process", "counters", "invalid"] },
    "sources": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "object", "required": ["adapter"], "properties": { "adapter": { "enum": ["observer_envelope", "raw_hex"] } } } },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["take"],
               "properties": { "take": { "type": "integer", "minimum": 1, "maximum": 500 }, "crash": { "type": "boolean" } } } },
    "captures": { "type": "array", "minItems": 1, "maxItems": 500 },
    "expect": { "type": "object", "additionalProperties": false, "required": ["outcomes", "packets", "receptions", "hours"],
                "properties": { "outcomes": { "type": "array" }, "packets": { "type": "array" }, "receptions": { "type": "array" }, "hours": { "type": "array" } } },
    "after": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "counters": { "type": "object" },
    "cases": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["schema", "note", "value"],
               "properties": { "schema": { "enum": ["committed-capture", "outcome", "packet", "reception", "hour", "counters"] }, "note": { "type": "string" }, "value": {} } } }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "process" } } }, "then": { "required": ["sources", "captures", "expect"] } },
    { "if": { "properties": { "kind": { "const": "counters" } } }, "then": { "required": ["after", "counters"] } },
    { "if": { "properties": { "kind": { "const": "invalid" } } }, "then": { "required": ["cases"] } }
  ]
}
