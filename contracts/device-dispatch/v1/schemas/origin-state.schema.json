{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/mecon/device-dispatch/v1/origin-state",
  "title": "Origin scheduling state after one step",
  "type": "object",
  "additionalProperties": false,
  "required": ["origins", "window_ends_at", "scheduled", "closed", "ignored_results"],
  "properties": {
    "origins": {
      "type": "array", "maxItems": 2,
      "items": { "type": "object", "additionalProperties": false, "required": ["gateway", "result", "transmitted_at"],
        "properties": {
          "gateway": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
          "result": { "enum": ["queued", "duty_held", "transmitted", "refused", "expired", "failed", "unknown", null] },
          "transmitted_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
        } }
    },
    "window_ends_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "scheduled": { "type": "array", "items": { "type": "string" }, "maxItems": 1 },
    "closed": { "enum": ["native_ack", "second_origin", "no_second_origin", "no_origin", "no_automatic_retry", null] },
    "ignored_results": { "type": "integer", "minimum": 0 }
  }
}
