{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoejriis/mecon-backend/contracts/connector/v1/mapping.schema.json",
  "title": "MECON USB Connector contract",
  "type": "object",
  "required": ["contract", "version", "status", "sources", "transparency", "serial", "mqtt", "delivery", "queues", "health", "metrics", "metrics_prefix", "errors", "open_questions"],
  "additionalProperties": true,
  "properties": {
    "contract": { "const": "mecon-usb-connector" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-draft\\.\\d+)?$" },
    "status": { "enum": ["draft", "frozen"] },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["repo", "path", "commit", "used_for"], "additionalProperties": false,
        "properties": {
          "repo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
          "path": { "type": "string" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "used_for": { "type": "string" }
        }
      }
    },
    "transparency": { "type": "array", "minItems": 5, "items": { "type": "string" } },
    "serial": {
      "type": "object", "required": ["selection", "baud", "companion", "console"],
      "properties": {
        "baud": { "const": 115200 },
        "companion": {
          "type": "object", "required": ["wrapper", "classification", "mecon_frame", "downlink"],
          "properties": {
            "wrapper": {
              "type": "object", "required": ["device_to_host_marker", "host_to_device_marker", "max_payload"],
              "properties": {
                "device_to_host_marker": { "const": "0x3E" },
                "host_to_device_marker": { "const": "0x3C" },
                "max_payload": { "const": 176 }
              }
            },
            "classification": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["match", "class", "action"] } },
            "mecon_frame": {
              "type": "object", "required": ["body_max", "count", "message_max", "incomplete_timeout_s"],
              "properties": {
                "body_max": { "const": 168 },
                "count": { "const": [1, 25] },
                "message_max": { "const": 4096 },
                "incomplete_timeout_s": { "const": 5 }
              }
            }
          }
        },
        "console": {
          "type": "object", "required": ["max_line_bytes", "accepted_prefix", "downlink"],
          "properties": { "max_line_bytes": { "const": 1600 }, "accepted_prefix": { "const": "mecon> {" } }
        }
      }
    },
    "mqtt": {
      "type": "object", "required": ["protocol", "clean_session", "topics", "client_id", "brokers", "reconnect"],
      "properties": {
        "protocol": { "const": "3.1.1" },
        "clean_session": { "const": true },
        "topics": {
          "type": "object", "required": ["up", "down", "status"], "additionalProperties": false,
          "properties": {
            "up": { "$ref": "#/$defs/topic" },
            "down": { "$ref": "#/$defs/topic" },
            "status": { "$ref": "#/$defs/topic" }
          }
        },
        "brokers": { "type": "object", "required": ["max", "order", "active", "hold_down_s_default"], "properties": { "max": { "type": "integer", "minimum": 1, "maximum": 6 } } },
        "reconnect": {
          "type": "object", "required": ["owner", "new_client_per_session", "backoff"],
          "properties": {
            "new_client_per_session": { "const": true },
            "backoff": {
              "type": "object", "required": ["network_or_timeout", "auth_or_tls_refused", "jitter", "reset_after_stable_s"],
              "properties": {
                "network_or_timeout": { "$ref": "#/$defs/backoffClass" },
                "auth_or_tls_refused": { "$ref": "#/$defs/backoffClass" },
                "jitter": { "type": "number", "minimum": 0, "maximum": 0.5 }
              }
            }
          }
        }
      }
    },
    "delivery": {
      "type": "object", "required": ["stages", "retry_rules", "never"],
      "properties": {
        "retry_rules": {
          "type": "array", "minItems": 5,
          "items": { "type": "object", "required": ["what", "retried", "rule"], "properties": { "retried": { "type": "boolean" } } }
        },
        "never": { "type": "array", "contains": { "const": "write a command twice" } }
      }
    },
    "queues": {
      "type": "object", "required": ["upstream", "downlink", "silent_drops"],
      "properties": { "silent_drops": { "const": "forbidden: every drop increments a metric" } }
    },
    "metrics_prefix": { "const": "mecon_connector_" },
    "metrics": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "type", "labels"], "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["counter", "gauge"] },
          "labels": { "type": "object", "maxProperties": 1, "additionalProperties": { "type": "array", "minItems": 2, "items": { "type": "string" }, "uniqueItems": true } }
        },
        "if": { "properties": { "type": { "const": "counter" } } },
        "then": { "properties": { "name": { "pattern": "_total$" } } }
      }
    },
    "errors": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["id", "condition", "behaviour"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "condition": { "type": "string" }, "behaviour": { "type": "string" } } }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "owner", "question"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "owner": { "type": "string" }, "question": { "type": "string" } } }
    }
  },
  "$defs": {
    "topic": {
      "type": "object", "required": ["template", "direction", "provisional"],
      "properties": {
        "template": { "type": "string", "pattern": "^\\{topic_root\\}/[a-z/]+$" },
        "direction": { "enum": ["connector_to_broker", "broker_to_connector"] },
        "qos": { "enum": [0, 1] },
        "subscribe_qos": { "enum": [0, 1] },
        "retain": { "type": "boolean" },
        "provisional": { "const": true }
      }
    },
    "backoffClass": {
      "type": "object", "required": ["base_s", "factor", "max_s"],
      "properties": { "base_s": { "type": "number", "minimum": 0.1 }, "factor": { "const": 2 }, "max_s": { "type": "number", "maximum": 3600 } }
    }
  }
}
