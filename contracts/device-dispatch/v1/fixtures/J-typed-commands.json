{
 "fixture": "J",
 "title": "Typed commands: every catalogue op accepted, and invalid commands refused before anything is signed",
 "kind": "commands",
 "contract_version": "1.0.0-draft.1",
 "cases": [
  {
   "note": "contact.put by a caller to a companion",
   "by": "caller",
   "role": "companion",
   "command": {
    "op": "contact.put",
    "args": {
     "contact_ref": "ctc_1",
     "name": "Synthetic One"
    }
   },
   "expect": {
    "valid": true
   }
  },
  {
   "note": "contact.remove by a caller to a companion",
   "by": "caller",
   "role": "companion",
   "command": {
    "op": "contact.remove",
    "args": {
     "contact_ref": "ctc_1"
    }
   },
   "expect": {
    "valid": true
   }
  },
  {
   "note": "message.send, direct, by a caller to a companion",
   "by": "caller",
   "role": "companion",
   "command": {
    "op": "message.send",
    "args": {
     "kind": "direct",
     "target": "ctc_2",
     "text": "synthetic hello"
    }
   },
   "expect": {
    "valid": true
   }
  },
  {
   "note": "packet.transmit to a repeater",
   "by": "caller",
   "role": "repeater",
   "command": {
    "op": "packet.transmit",
    "args": {
     "packet_hex": "0a0b0c0d"
    }
   },
   "expect": {
    "valid": true
   }
  },
  {
   "note": "config.apply to a repeater",
   "by": "caller",
   "role": "repeater",
   "command": {
    "op": "config.apply",
    "args": {
     "settings": {
      "tx_power": 14,
      "repeat": true
     }
    }
   },
   "expect": {
    "valid": true
   }
  },
  {
   "note": "job.cancel signed by the Backend",
   "by": "backend",
   "role": "companion",
   "command": {
    "op": "job.cancel",
    "args": {
     "target_job_number": 4
    }
   },
   "expect": {
    "valid": true
   }
  },
  {
   "note": "job.get signed by the Backend",
   "by": "backend",
   "role": "repeater",
   "command": {
    "op": "job.get",
    "args": {
     "target_job_number": 4
    }
   },
   "expect": {
    "valid": true
   }
  },
  {
   "note": "an op the catalogue does not list",
   "by": "caller",
   "role": "companion",
   "command": {
    "op": "device.reboot",
    "args": {}
   },
   "expect": {
    "valid": false,
    "reason": "unknown_op"
   }
  },
  {
   "note": "job.get requested by a caller",
   "by": "caller",
   "role": "companion",
   "command": {
    "op": "job.get",
    "args": {
     "target_job_number": 4
    }
   },
   "expect": {
    "valid": false,
    "reason": "internal_op"
   }
  },
  {
   "note": "contact.put to a repeater: a known op for the wrong role",
   "by": "caller",
   "role": "repeater",
   "command": {
    "op": "contact.put",
    "args": {
     "contact_ref": "ctc_1",
     "name": "Synthetic One"
    }
   },
   "expect": {
    "valid": false,
    "reason": "wrong_role"
   }
  },
  {
   "note": "message.send to a repeater",
   "by": "caller",
   "role": "repeater",
   "command": {
    "op": "message.send",
    "args": {
     "kind": "direct",
     "target": "ctc_2",
     "text": "synthetic hello"
    }
   },
   "expect": {
    "valid": false,
    "reason": "wrong_role"
   }
  },
  {
   "note": "contact.remove with no args",
   "by": "caller",
   "role": "companion",
   "command": {
    "op": "contact.remove",
    "args": {}
   },
   "expect": {
    "valid": false,
    "reason": "invalid_args"
   }
  },
  {
   "note": "contact.remove with an extra arg",
   "by": "caller",
   "role": "companion",
   "command": {
    "op": "contact.remove",
    "args": {
