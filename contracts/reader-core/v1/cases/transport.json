  {
   "id": "transport-06",
   "title": "A degraded core answers 503 core_unavailable everywhere, then recovers",
   "world": "two-fleets",
   "steps": [
    {
     "action": "issue-session",
     "args": {
      "user": "alice"
     },
     "capture": "a_ref"
    },
    {
     "action": "user-id",
     "args": {
      "user": "alice"
     },
     "capture": "a_uid"
    },
    {
     "action": "core-degraded",
     "args": {}
    },
    {
     "request": {
      "operation": "getHealth"
     },
     "expect": {
      "status": 503,
      "schema": "Refusal",
      "body": {
       "/code": "core_unavailable",
       "/retryable": true
      }
     }
    },
    {
     "request": {
      "operation": "startLogin",
      "body": {
       "email": "alice@example.test",
       "origin": "https://reader.example.test",
       "sec_fetch_site": "same-origin",
       "client_address": "192.0.2.10"
      }
     },
     "expect": {
      "status": 503,
      "schema": "Refusal",
      "body": {
       "/code": "core_unavailable",
       "/retryable": true
      }
     }
    },
    {
     "request": {
      "operation": "listConversations",
      "body": {
       "caller": {
        "user_id": "${a_uid}",
        "session_ref": "${a_ref}"
       }
      }
     },
     "expect": {
      "status": 503,
      "schema": "Refusal",
      "body": {
       "/code": "core_unavailable",
