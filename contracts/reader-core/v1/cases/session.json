{
 "contract": "mecon-reader-core/1.0.0-draft.3",
 "synthetic": true,
 "group": "session",
 "cases": [
  {
   "id": "session-01",
   "title": "Health answers ok with the deployed commit",
   "world": "two-fleets",
   "steps": [
    {
     "request": {
      "operation": "getHealth"
     },
     "expect": {
      "status": 200,
      "schema": "Health",
      "body": {
       "/status": "ok"
      }
     }
    }
   ]
  },
  {
   "id": "session-02",
   "title": "A login from the allow-listed origin is approved once, then reads delivered",
   "world": "two-fleets",
   "steps": [
    {
     "request": {
      "operation": "startLogin",
      "body": {
       "email": "alice@example.test",
       "origin": "https://reader.example.test",
       "sec_fetch_site": "cross-site",
       "client_address": "192.0.2.10"
      }
     },
     "expect": {
      "status": 202,
      "schema": "LoginStarted"
     },
     "capture": {
      "rid": "/request_id"
     }
    },
    {
     "request": {
      "operation": "pollLogin",
      "body": {
       "request_id": "${rid}",
       "client_address": "192.0.2.10"
      }
     },
     "expect": {
      "status": 200,
      "schema": "LoginPoll",
      "body": {
       "/state": "pending"
      }
     }
    },
    {
     "action": "approve-login",
     "args": {
      "request_id": "${rid}"
     }
    },
    {
     "request": {
      "operation": "pollLogin",
      "body": {
       "request_id": "${rid}",
       "client_address": "192.0.2.10"
      }
     },
     "expect": {
      "status": 200,
      "schema": "LoginPoll",
      "body": {
       "/state": "approved"
      }
     }
    },
    {
     "request": {
      "operation": "pollLogin",
      "body": {
       "request_id": "${rid}",
       "client_address": "192.0.2.10"
      }
     },
     "expect": {
      "status": 200,
      "schema": "LoginPoll",
      "body": {
       "/state": "delivered"
      }
     }
    }
   ]
  },
  {
   "id": "session-03",
   "title": "The Origin rule: a trailing slash is removed, same-origin passes without an Origin",
   "world": "two-fleets",
   "steps": [
    {
     "request": {
      "operation": "startLogin",
      "body": {
       "email": "alice@example.test",
       "origin": "https://reader.example.test/",
       "sec_fetch_site": "cross-site",
       "client_address": "192.0.2.10"
      }
     },
     "expect": {
      "status": 202,
      "schema": "LoginStarted"
     }
    },
    {
     "request": {
      "operation": "startLogin",
      "body": {
       "email": "alice@example.test",
       "origin": null,
       "sec_fetch_site": "same-origin",
       "client_address": "192.0.2.10"
      }
     },
     "expect": {
      "status": 202,
      "schema": "LoginStarted"
     }
    },
    {
     "request": {
      "operation": "startLogin",
      "body": {
       "email": "alice@example.test",
       "origin": "https://foreign.example.test",
       "sec_fetch_site": "same-origin",
       "client_address": "192.0.2.10"
      }
     },
     "expect": {
      "status": 202,
      "schema": "LoginStarted"
     }
    }
   ]
  },
  {
   "id": "session-04",
   "title": "A foreign or missing Origin without same-origin is refused origin_rejected",
   "world": "two-fleets",
   "steps": [
    {
     "request": {
      "operation": "startLogin",
      "body": {
       "email": "alice@example.test",
       "origin": "https://foreign.example.test",
       "sec_fetch_site": "cross-site",
       "client_address": "192.0.2.10"
      }
     },
     "expect": {
      "status": 403,
      "schema": "Refusal",
      "body": {
       "/code": "origin_rejected",
       "/retryable": false
      }
     }
    },
    {
     "request": {
      "operation": "startLogin",
      "body": {
       "email": "alice@example.test",
       "origin": null,
       "sec_fetch_site": null,
       "client_address": "192.0.2.10"
      }
     },
     "expect": {
      "status": 403,
      "schema": "Refusal",
      "body": {
       "/code": "origin_rejected",
       "/retryable": false
      }
     }
    }
   ]
  },
