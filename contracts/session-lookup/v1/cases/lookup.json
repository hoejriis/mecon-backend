  {
   "id": "lookup-17",
   "title": "A core that cannot answer says core_unavailable, retryable",
   "world": "basic",
   "steps": [
    {
     "action": "issue-session",
     "args": {
      "user": "alice"
     },
     "capture": "cookie"
    },
    {
     "action": "core-degraded",
     "args": {}
    },
    {
     "request": {
      "operation": "lookupCaller",
      "body": {
       "credential": "${cookie}",
       "purpose": "read",
       "origin": null,
       "sec_fetch_site": "same-origin"
      }
     },
     "expect": {
      "status": 503,
      "schema": "Unavailable",
      "body": {
       "/reason": "core_unavailable",
       "/retryable": true
      }
     }
    },
    {
     "action": "core-recovered",
     "args": {}
    },
    {
     "request": {
      "operation": "lookupCaller",
      "body": {
