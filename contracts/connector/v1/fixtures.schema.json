{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoejriis/mecon-backend/contracts/connector/v1/fixtures.schema.json",
  "title": "MECON USB Connector fixtures (synthetic)",
  "type": "object",
  "required": ["contract", "synthetic", "note", "direction", "cases"],
  "additionalProperties": false,
  "properties": {
    "contract": { "type": "string", "pattern": "^mecon-usb-connector/\\d+\\.\\d+\\.\\d+(-draft\\.\\d+)?$" },
    "synthetic": { "const": true },
    "note": { "type": "string" },
    "direction": { "enum": ["device_to_broker", "broker_to_device", "enrolment_gate"] },
    "cases": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/upCase" }, { "$ref": "#/$defs/downCase" }, { "$ref": "#/$defs/gateCase" }] } }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "mode": { "enum": ["companion", "console"] },
    "upCase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "mode", "serial_chunks_hex", "chunkings", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string" },
        "mode": { "$ref": "#/$defs/mode" },
        "source": { "type": "string" },
        "serial_chunks_hex": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hex" } },
        "chunkings": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "const": "whole" }, { "const": "bytes" }, { "type": "integer", "minimum": 1 }] } },
        "expect": {
          "type": "object", "required": ["publishes", "metrics"], "additionalProperties": false,
          "properties": {
            "publishes": {
              "type": "array",
              "items": {
                "type": "object", "required": ["topic", "payload_hex", "qos", "retain"], "additionalProperties": false,
                "properties": { "topic": { "type": "string", "pattern": "^\\{(resp|ev:[A-Za-z0-9_-]{1,32})\\}$" }, "payload_hex": { "$ref": "#/$defs/hex" }, "qos": { "const": 1 }, "retain": { "const": false } }
              }
            },
            "metrics": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
          }
        }
      }
    },
    "gateCase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "mode", "enrolment", "expect", "then"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string" },
        "mode": { "$ref": "#/$defs/mode" },
        "enrolment": { "enum": ["provisioned", "none", "corrupt", "silent", "garbage", "refused", "bad_state", "busy", "failed"] },
        "expect": {
          "type": "object", "additionalProperties": false,
          "required": ["probe_request_hex", "gate_open", "probe_result", "upstream_publishes"],
          "properties": {
            "probe_request_hex": { "$ref": "#/$defs/hex" },
            "gate_open": { "type": "boolean" },
            "probe_result": { "enum": ["provisioned", "none", "corrupt", "malformed", "busy", "failed", "refused", "timeout"] },
            "upstream_publishes": { "enum": [0, 1] }
          }
        },
        "then": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["uplink", "enrolment_after", "gate_open_after", "forwarded"],
                "properties": {
                  "uplink": { "enum": ["signed_event", "unsigned_event", "new_epoch_event"] },
                  "enrolment_after": { "enum": [null, "provisioned", "none", "corrupt"] },
                  "gate_open_after": { "type": "boolean" },
                  "forwarded": { "const": true }
                }
              },
              {
                "description": "The device answers the next deployment.get as enrolment_after; it is asked after_s seconds after the previous answer (recheck_s, retry_s or busy_retry_s at their defaults).",
                "type": "object", "additionalProperties": false,
                "required": ["probe_after_s", "enrolment_after", "probe_result_after", "gate_open_after"],
                "properties": {
                  "probe_after_s": { "type": "number", "minimum": 1 },
                  "enrolment_after": { "enum": ["provisioned", "none", "corrupt", "refused", "busy", "failed"] },
                  "probe_result_after": { "enum": ["provisioned", "none", "corrupt", "refused", "busy", "failed"] },
                  "gate_open_after": { "type": "boolean" }
                }
              }
            ]
          }
        }
      }
    },
    "downCase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "mode", "inbound", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string" },
        "mode": { "$ref": "#/$defs/mode" },
        "inbound": {
          "type": "object", "required": ["topic", "payload_hex", "retain"], "additionalProperties": false,
          "properties": { "topic": { "const": "{req}" }, "payload_hex": { "$ref": "#/$defs/hex" }, "retain": { "type": "boolean" } }
        },
        "expect": {
          "type": "object", "required": ["serial_written_hex", "dropped_reason"], "additionalProperties": false,
          "properties": {
            "serial_written_hex": { "oneOf": [{ "$ref": "#/$defs/hex" }, { "type": "null" }] },
            "dropped_reason": { "oneOf": [{ "enum": ["queue_full", "ttl", "serial_down", "retained", "invalid", "too_large"] }, { "type": "null" }] }
          }
        }
      }
    }
  }
}
