{
  "contract": "mecon-reader-api/1.0.0-draft.11",
  "synthetic": true,
  "group": "events",
  "cases": [
    { "id": "events-01", "title": "Each sender sees its own attempt_status events and never another fleet's", "world": "two-fleets", "steps": [
      { "action": "sign-in", "args": { "client": "alice", "user": "alice" } },
      { "action": "sign-in", "args": { "client": "carol", "user": "carol" } },
      { "action": "events-checkpoint", "capture": "cp" },
      { "as": "alice", "request": { "operation": "listIdentities" }, "expect": { "status": 200, "schema": "IdentityList" }, "capture": { "me": "/items/0/id" } },
      { "as": "alice", "request": { "operation": "listContacts" }, "expect": { "status": 200, "schema": "ContactList" },
        "capture": { "bob": { "at": "/items", "where": { "/display_name": "Bob (synthetic)" }, "field": "/id" } } },
      { "as": "alice", "request": { "operation": "createSendAttempt", "headers": { "Idempotency-Key": "att_synthetic_ev" },
        "body": { "client_draft_id": "drf_synthetic_ev", "client_attempt_id": "att_synthetic_ev", "identity_id": "${me}", "target": { "kind": "contact", "id": "${bob}" }, "content": { "kind": "text", "text": "evented (synthetic)" } } },
        "expect": { "status": 201, "schema": "SendAttempt" }, "capture": { "att": "/id" } },
      { "as": "alice", "request": { "operation": "streamEvents", "query": { "cursor": "${cp}" } }, "expect": { "status": 200, "schema": "EventEnvelope", "stream": { "match": [
        { "at": "", "where": { "/kind": "attempt_status", "/resource_id": "${att}" }, "at_least": 1 } ] } } },
      { "as": "carol", "request": { "operation": "listIdentities" }, "expect": { "status": 200, "schema": "IdentityList" }, "capture": { "carol_me": "/items/0/id" } },
      { "as": "carol", "request": { "operation": "listContacts" }, "expect": { "status": 200, "schema": "ContactList" },
        "capture": { "erin": { "at": "/items", "where": { "/display_name": "Erin (synthetic)" }, "field": "/id" } } },
      { "as": "carol", "request": { "operation": "createSendAttempt", "headers": { "Idempotency-Key": "att_synthetic_ev_c" },
        "body": { "client_draft_id": "drf_synthetic_ev_c", "client_attempt_id": "att_synthetic_ev_c", "identity_id": "${carol_me}", "target": { "kind": "contact", "id": "${erin}" }, "content": { "kind": "text", "text": "carol evented (synthetic)" } } },
        "expect": { "status": 201, "schema": "SendAttempt" }, "capture": { "carol_att": "/id" } },
      { "as": "carol", "request": { "operation": "streamEvents", "query": { "cursor": "${cp}" } }, "expect": { "status": 200, "schema": "EventEnvelope", "stream": { "match": [
        { "at": "", "where": { "/kind": "attempt_status", "/resource_id": "${carol_att}" }, "at_least": 1 },
        { "at": "", "where": { "/resource_id": "${att}" }, "count": 0 } ] } } } ] },
    { "id": "events-02", "title": "An expired cursor is 410 cursor_expired before the stream starts", "world": "two-fleets", "steps": [
      { "action": "sign-in", "args": { "client": "alice", "user": "alice" } },
      { "action": "events-checkpoint", "capture": "old" },
      { "action": "age-out-events" },
      { "as": "alice", "request": { "operation": "streamEvents", "query": { "cursor": "${old}" } }, "expect": { "status": 410, "schema": "Error", "body": { "/code": "cursor_expired" } } },
      { "as": "alice", "request": { "operation": "streamEvents", "headers": { "Last-Event-ID": "${old}" } }, "expect": { "status": 410, "schema": "Error", "body": { "/code": "cursor_expired" } } } ] },
    { "id": "events-03", "title": "Last-Event-ID wins over the cursor parameter", "world": "two-fleets", "steps": [
      { "action": "sign-in", "args": { "client": "alice", "user": "alice" } },
      { "action": "events-checkpoint", "capture": "old" },
      { "action": "age-out-events" },
      { "action": "events-checkpoint", "capture": "cp" },
      { "as": "alice", "request": { "operation": "streamEvents", "query": { "cursor": "${old}" }, "headers": { "Last-Event-ID": "${cp}" } }, "expect": { "status": 200, "schema": "EventEnvelope", "stream": {} } } ] },
    { "id": "events-04", "title": "The stream needs a session", "world": "two-fleets", "steps": [
      { "request": { "operation": "streamEvents" }, "expect": { "status": 401, "schema": "Error", "body": { "/code": "unauthenticated" } } } ] },
    {"id": "events-05", "title": "A session ended on the server cannot open the stream again", "world": "two-fleets", "steps": [{"action": "sign-in", "args": {"client": "alice", "user": "alice"}}, {"as": "alice", "request": {"operation": "streamEvents"}, "expect": {"status": 200, "schema": "EventEnvelope", "stream": {}}}, {"action": "end-session", "args": {"client": "alice"}}, {"as": "alice", "request": {"operation": "streamEvents"}, "expect": {"status": 401, "schema": "Error", "body": {"/code": "unauthenticated"}}}, {"as": "alice", "request": {"operation": "getSession"}, "expect": {"status": 401, "schema": "Error", "body": {"/code": "unauthenticated"}}}]},
    {"id": "events-06", "title": "A cursor longer than the parameter allows is 422 invalid, not 410", "world": "two-fleets", "steps": [{"action": "sign-in", "args": {"client": "alice", "user": "alice"}}, {"as": "alice", "request": {"operation": "streamEvents", "query": {"cursor": ""}}, "expect": {"status": 422, "schema": "Error", "body": {"/code": "invalid", "/retryable": false}}}]}
  ]
}
