     "force": true
    }
   },
   "expect": {
    "valid": false,
    "reason": "invalid_args"
   }
  },
  {
   "note": "contact.remove with no args key at all",
   "by": "caller",
   "role": "companion",
   "command": {
    "op": "contact.remove"
   },
   "expect": {
    "valid": false,
    "reason": "invalid_args"
   }
  },
  {
   "note": "a command with an extra top-level key",
   "by": "caller",
   "role": "companion",
   "command": {
    "op": "contact.remove",
    "args": {
     "contact_ref": "ctc_1"
    },
    "raw": "x"
   },
   "expect": {
    "valid": false,
    "reason": "invalid_args"
   }
  },
  {
   "note": "message.send with a kind outside the enum",
   "by": "caller",
   "role": "companion",
   "command": {
    "op": "message.send",
    "args": {
     "kind": "broadcast",
     "target": "ctc_2",
     "text": "x"
    }
   },
   "expect": {
    "valid": false,
    "reason": "invalid_args"
   }
  },
  {
   "note": "packet.transmit with an odd number of hex digits",
   "by": "caller",
   "role": "repeater",
   "command": {
    "op": "packet.transmit",
    "args": {
     "packet_hex": "0a0b0c0"
    }
   },
   "expect": {
    "valid": false,
    "reason": "invalid_args"
   }
  },
  {
   "note": "config.apply with no settings",
   "by": "caller",
   "role": "repeater",
   "command": {
    "op": "config.apply",
    "args": {
     "settings": {}
    }
   },
   "expect": {
    "valid": false,
    "reason": "invalid_args"
   }
  },
  {
   "note": "an op that is not a string",
   "by": "caller",
   "role": "companion",
   "command": {
    "op": 7,
    "args": {}
   },
   "expect": {
    "valid": false,
    "reason": "unknown_op"
   }
  },
  {
   "note": "a command that is not an object",
   "by": "caller",
   "role": "companion",
   "command": "contact.put",
   "expect": {
    "valid": false,
    "reason": "unknown_op"
   }
  },
  {
   "note": "job.cancel with job number 0, signed by the Backend",
   "by": "backend",
   "role": "companion",
   "command": {
    "op": "job.cancel",
    "args": {
     "target_job_number": 0
    }
   },
   "expect": {
    "valid": false,
    "reason": "invalid_args"
   }
  }
 ]
}
