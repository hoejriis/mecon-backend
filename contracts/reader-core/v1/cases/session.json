       "/state": "pending"
      }
     }
    }
   ]
  },
  {
   "id": "session-06",
   "title": "Over the login limit for its client address a login start answers 429 rate_limited; another address is served",
   "world": "two-fleets",
   "steps": [
    {
     "action": "exhaust-login-limit",
     "args": {
      "client_address": "192.0.2.20"
     }
    },
    {
     "request": {
      "operation": "startLogin",
      "body": {
       "email": "alice@example.test",
       "origin": "https://reader.example.test",
       "sec_fetch_site": "cross-site",
       "client_address": "192.0.2.20"
      }
     },
     "expect": {
      "status": 429,
      "schema": "RateLimited",
      "body": {
       "/code": "rate_limited",
       "/retryable": true
      }
     }
    },
    {
     "request": {
      "operation": "startLogin",
      "body": {
       "email": "alice@example.test",
       "origin": "https://reader.example.test",
       "sec_fetch_site": "cross-site",
       "client_address": "2001:db8::20"
      }
     },
     "expect": {
      "status": 202,
      "schema": "LoginStarted"
     }
    }
   ]
  },
  {
   "id": "session-07",
   "title": "Over the login limit for its client address a poll answers 429 rate_limited; another address reads on",
   "world": "two-fleets",
   "steps": [
    {
     "request": {
      "operation": "startLogin",
      "body": {
       "email": "alice@example.test",
       "origin": "https://reader.example.test",
       "sec_fetch_site": "cross-site",
       "client_address": "192.0.2.30"
