{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation-subscription/v1/fixtures",
  "title": "Observation subscription fixtures",
  "type": "object",
  "required": [
    "fixture",
    "title",
    "kind"
  ],
  "properties": {
    "fixture": {
      "type": "string",
      "pattern": "^[A-Z]$"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "profiles",
        "sequence",
        "ingester"
      ]
    },
    "expect": {
      "enum": [
        "valid",
        "invalid"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "note",
          "value"
        ],
        "properties": {
          "note": {
            "type": "string"
          },
          "value": {}
        }
      }
    },
    "profile": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event",
          "actions",
          "status"
        ],
        "properties": {
          "event": {
            "enum": [
              "start",
              "connack",
              "suback",
              "disconnect",
              "stop"
            ]
          },
          "code": {
            "type": "integer",
            "minimum": 0
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "granted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "refused": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subscribe",
                "qos"
              ],
              "properties": {
                "subscribe": {
                  "type": "string"
                },
                "qos": {
                  "const": 0
                }
              }
            }
          },
          "status": {
            "type": "object"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buffer_bound",
        "max_receive_bytes"
      ],
      "properties": {
        "buffer_bound": {
          "type": "integer",
          "minimum": 1
        },
        "max_receive_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event",
          "expect"
        ],
        "properties": {
          "event": {
            "enum": [
              "message",
              "append"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "storage": {
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "expect": {
            "type": "object"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "profiles"
          }
        }
      },
      "then": {
        "required": [
          "expect",
          "cases"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "sequence"
          }
        }
      },
      "then": {
        "required": [
          "profile",
          "steps"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ingester"
          }
        }
      },
      "then": {
        "required": [
          "limits",
          "events"
        ]
      }
    }
  ]
}
