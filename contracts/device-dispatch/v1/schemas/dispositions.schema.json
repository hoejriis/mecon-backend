{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/mecon/device-dispatch/v1/dispositions",
  "title": "The dispositions of one attempt",
  "description": "Five separate facts, each with its own timestamp or null. None implies another. acked is the native ACK of a direct message.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signed",
    "transport_accepted",
    "device_answered",
    "rf_transmitted",
    "acked"
  ],
  "properties": {
    "signed": {
      "$ref": "#/$defs/at"
    },
    "transport_accepted": {
      "$ref": "#/$defs/at"
    },
    "device_answered": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "error",
            "state",
            "outcome",
            "duty_held",
            "at"
          ],
          "properties": {
            "status": {
              "enum": [
                "ok",
                "refused",
                "invalid",
                "unknown-op",
                "unsupported-version",
                "busy",
                "failed"
              ]
            },
            "at": {
              "$ref": "#/$defs/ts"
            },
            "error": {
              "enum": [
                "replay",
                "duplicate",
                "job-open",
                "unknown-job",
                null
              ]
            },
            "state": {
              "enum": [
                "accepted",
                "progress",
                "applied",
                "awaiting-confirm",
                "confirmed",
                "reverted",
                "failed",
                "cancelled",
                "unknown",
                "queued",
                "duty-held",
                "transmitted",
                "acked",
                "timed-out",
                null
              ]
            },
            "outcome": {
              "enum": [
                "transmitted",
                "expired",
                "failed",
                "unknown",
                null
              ]
            },
            "duty_held": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "rf_transmitted": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "first_at",
            "last_at"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "first_at": {
              "$ref": "#/$defs/ts"
            },
            "last_at": {
              "$ref": "#/$defs/ts"
            }
          }
        }
      ]
    },
    "acked": {
      "$ref": "#/$defs/at"
    }
  },
  "$defs": {
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "at": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ts"
        }
      ]
    }
  }
}
