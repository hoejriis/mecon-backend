{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mecon:public-map:v1:cases",
  "title": "Public map feed conformance cases (synthetic)",
  "description": "One file of replayable cases. See README.md for how an implementation replays them.",
  "type": "object",
  "required": [
    "contract",
    "synthetic",
    "group",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "type": "string",
      "pattern": "^mecon-public-map/\\d+\\.\\d+\\.\\d+(-draft\\.\\d+)?$"
    },
    "synthetic": {
      "const": true
    },
    "group": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "title",
        "world",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "world": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/action"
              },
              {
                "$ref": "#/$defs/request"
              }
            ]
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "capture": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "request": {
      "type": "object",
      "required": [
        "request",
        "expect"
      ],
      "additionalProperties": false,
      "properties": {
        "as": {
          "$ref": "#/$defs/name",
          "description": "The client (cookie jar). Defaults to a fresh anonymous client."
        },
        "request": {
          "type": "object",
          "required": [
            "operation"
          ],
          "additionalProperties": false,
          "properties": {
            "operation": {
              "type": "string",
              "description": "An operationId of openapi.yaml."
            },
            "path": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "query": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "origin": {
              "enum": [
                "same",
                "foreign",
                "absent"
              ],
              "default": "same"
            },
            "csrf": {
              "enum": [
                "valid",
                "absent",
                "wrong"
              ],
              "default": "valid",
              "description": "Applies only to operations with an X-CSRF-Token parameter."
            },
            "body": {},
            "invalid": {
              "type": "boolean",
              "description": "The body deliberately fails the request schema; the validator checks that it does."
            }
          }
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "capture": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/selector"
          }
        }
      }
    },
    "selector": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(/[^/]*)*$",
          "description": "A JSON pointer into the response body."
        },
        {
          "type": "object",
          "required": [
            "at",
            "where",
            "field"
          ],
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "string",
              "pattern": "^(/[^/]*)*$"
            },
            "where": {
              "$ref": "#/$defs/where"
            },
            "field": {
              "type": "string",
              "pattern": "^(/[^/]*)+$"
            }
          },
          "description": "The field of the first array item at `at` matching `where`."
        }
      ]
    },
    "where": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(/[^/]*)+$"
      },
      "description": "JSON pointer (relative to the item) to value; every pair must equal."
    },
    "match": {
      "type": "object",
      "required": [
        "at",
        "where"
      ],
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string",
          "pattern": "^(/[^/]*)*$"
        },
        "where": {
          "$ref": "#/$defs/where"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "at_least": {
          "type": "integer",
          "minimum": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "count"
          ]
        },
        {
          "required": [
            "at_least"
          ]
        }
      ]
    },
    "expect": {
      "type": "object",
      "required": [
        "status",
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "schema": {
          "type": [
            "string",
            "null"
          ],
          "description": "Component schema name of the declared response body, or null when none is declared."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "\"present\", \"absent\" or an exact value."
        },
        "body": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(/[^/]*)+$"
          },
          "description": "JSON pointer to exact value."
        },
        "match": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/match"
          }
        },
        "stream": {
          "type": "object",
          "additionalProperties": false,
          "description": "A bounded read of an event stream: the frames the Backend holds for the cursor, then stop. Every frame validates against `schema`.",
          "properties": {
            "match": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/match"
              }
            }
          }
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ids"
          },
          "description": "Checks on the form of opaque ids in the body; see README.md."
        },
        "absent": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "What the response body must never carry, anywhere at any depth. `keys`: object keys, compared case-insensitively and exactly. `values`: markers (case-insensitive substrings) the world contains and that must not appear in any key or value of the serialized body. The validator refuses a key the response schema allows, a marker the world does not contain, and an `absent` with nothing positive beside it.",
          "properties": {
            "keys": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "spans": {
          "type": "array",
          "minItems": 1,
          "description": "For every item of the array at `at`, the time at `to` is exactly `seconds` after the time at `from` (both pointers relative to the item).",
          "items": {
            "type": "object",
            "required": [
              "at",
              "from",
              "to",
              "seconds"
            ],
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "string",
                "pattern": "^(/[^/]*)*$"
              },
              "from": {
                "type": "string",
                "pattern": "^(/[^/]*)+$"
              },
              "to": {
                "type": "string",
                "pattern": "^(/[^/]*)+$"
              },
              "seconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "ids": {
      "type": "object",
      "required": [
        "at",
        "field"
      ],
      "additionalProperties": false,
      "description": "The ids at `field` of every item of the array at `at`. `unsequenced`: at least two distinct ids, and once their longest common prefix and then their longest common suffix are removed, the remainders are not integers (decimal, or hex of one length) spread by less than 2^32. `unlike`: in each item, the id does not share a form (prefix up to and including the first `_` or `-`, and length) with the value at any of these pointers.",
      "properties": {
        "at": {
          "type": "string",
          "pattern": "^(/[^/]*)*$"
        },
        "field": {
          "type": "string",
          "pattern": "^(/[^/]*)+$"
        },
        "unsequenced": {
          "const": true
        },
        "unlike": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(/[^/]*)+$"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "unsequenced"
          ]
        },
        {
          "required": [
            "unlike"
          ]
        }
      ]
    }
  }
}
