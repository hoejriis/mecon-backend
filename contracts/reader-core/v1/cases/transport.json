      "user": "alice"
     },
     "capture": "a_uid"
    },
    {
     "action": "end-session",
     "args": {
      "session_ref": "${a_ref}"
     }
    },
    {
     "action": "core-degraded",
     "args": {}
    },
    {
     "request": {
      "operation": "listDevices",
      "body": {
       "caller": {
        "user_id": "${a_uid}",
        "session_ref": "${a_ref}"
       }
